<script>
var mode = 'staff';
var curStaff = 'details';
var curYp = 'home';

var staffNav = [
  {id:'details', icon:'👤', label:'Details'},
  {id:'contacts', icon:'📞', label:'Contacts'},
  {id:'calendar', icon:'📅', label:'Calendar'},
  {id:'todos', icon:'✅', label:'To-dos'},
  {id:'services', icon:'🏘️', label:'Services'},
];

var ypNav = [
  {id:'home', icon:'🏠', label:'Home'},
  {id:'conditions', icon:'📋', label:'Licence'},
  {id:'contacts', icon:'👥', label:'My team'},
  {id:'calendar', icon:'📅', label:'Dates'},
  {id:'todos', icon:'✅', label:'Checklist'},
  {id:'services', icon:'🏘️', label:'Help'},
];

function renderNav(defs, active, fn) {
  document.getElementById('bottom-nav').innerHTML = defs.map(function(d) {
    return '<button class="nav-item' + (d.id===active?' active':'') + '" onclick="' + fn + '(\'' + d.id + '\')">'
      + '<span class="nav-icon">' + d.icon + '</span>'
      + '<span class="nav-label" style="' + (d.id===active?'color:var(--or)':'') + '">' + d.label + '</span>'
      + '</button>';
  }).join('');
}

function setMode(m) {
  mode = m;
  document.querySelectorAll('.vtb').forEach(function(b, i) {
    b.classList.toggle('active', (i===0&&m==='staff')||(i===1&&m==='yp'));
  });
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
  document.querySelectorAll('.yp-page').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById('scroll-area').scrollTop = 0;

  if (m === 'staff') {
    document.getElementById('sp-' + curStaff).classList.add('active');
    document.getElementById('scroll-area').style.background = '#f5f5f5';
    renderNav(staffNav, curStaff, 'goStaff');
  } else {
    var fname = document.getElementById('fname').value;
    var lname = document.getElementById('lname').value;
    document.getElementById('yp-name-display').textContent = fname + ' ' + lname;
    document.getElementById('yp-' + curYp).classList.add('active');
    document.getElementById('scroll-area').style.background = '#1A1A2E';
    renderNav(ypNav, curYp, 'goYp');
  }
}

function goStaff(page) {
  curStaff = page;
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById('sp-' + page).classList.add('active');
  document.getElementById('scroll-area').scrollTop = 0;
  renderNav(staffNav, page, 'goStaff');
}

function goYp(page) {
  curYp = page;
  document.querySelectorAll('.yp-page').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById('yp-' + page).classList.add('active');
  document.getElementById('scroll-area').scrollTop = 0;
  renderNav(ypNav, page, 'goYp');
}

function ypNav(page) { goYp(page); }

function toggleTodo(el) {
  el.querySelector('.t-circle').classList.toggle('done');
  el.querySelector('.t-text').classList.toggle('done');
}

renderNav(staffNav, 'details', 'goStaff');
</script>

<!-- PWA Service Worker Registration -->
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('sw.js').then(function(reg) {
      console.log('SW registered');
    }).catch(function(err) {
      console.log('SW failed:', err);
    });
  });
}
</script>

